// Written for you by app/scripts/setup.sh; this is what it looks like. Git-ignored as Signing.xcconfig.
// DEVELOPMENT_TEAM: your Apple team ID (Xcode > Settings > Accounts).
// BAKEOUT_BUNDLE_ID: a bundle ID your team can own; the original com.bakeout.bakeout belongs to one team.
DEVELOPMENT_TEAM = YOURTEAMID
CODE_SIGN_STYLE = Automatic
BAKEOUT_BUNDLE_ID = com.bakeout.bakeout.yourteamid
